# Copy to .env and fill in. .env is gitignored -- never commit real values.

# Your FPL team id. Log in, view your team, and read it out of the URL:
#   https://fantasy.premierleague.com/entry/<THIS_NUMBER>/event/1
FPL_ENTRY_ID=

# Bearer token for /api/my-team/<id>/, which returns bank, purchase prices and
# free-transfer count. FPL uses bearer auth, NOT cookies -- every combination of
# the browser cookie jar returns 403, while this works.
#
# To get it: log in to fantasy.premierleague.com, then DevTools -> Application
# -> Cookies -> copy the value of `access_token`.
#
# It lasts about 8 hours, so grab it when you sit down for a session rather than
# expecting it to persist. fetch.py checks the expiry locally and reports the
# time it lapsed, instead of an opaque 403.
FPL_ACCESS_TOKEN=

# Do NOT store the refresh_token from that same cookie jar. It lasts months and
# its scope includes p1:update:user and p1:reset:userPassword -- an
# account-takeover credential, not read-only fantasy access. The 8-hour access
# token is deliberately the weaker thing to keep on disk.
#
# No-credentials alternative: save the my-team JSON from a logged-in browser to
# data/my-team.json, then run scripts/sync_squad.py (it reads that path by
# default). data/ is gitignored.

# Only needed to test scripts/notify.py locally -- in normal use these live in
# GitHub Secrets, not here. See the README for how to get them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Included in the reminder message so it carries a copy-pasteable cd.
# Left unset, the message just shows the command. Never hardcoded: this repo is
# public and the path is personal.
FPL_PROJECT_DIR=

# Optional. Your IANA timezone, e.g. Europe/London. Defaults to
# Australia/Sydney, which is where this was built and why the tooling works
# around overnight deadlines. An unrecognised zone warns rather than silently
# falling back.
FPL_TIMEZONE=

# Optional. Bookmaker odds are the strongest fixture-difficulty signal, and in
# preseason they are the ONLY good one -- the API's strength_attack_* and
# strength_defence_* fields are all zero until matches are played.
# Free tier (500 req/month) at https://the-odds-api.com -- a weekly pull costs ~4.
# Without this, project.py falls back to FPL's own difficulty ratings and marks
# the run as lower confidence.
ODDS_API_KEY=
